<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\Category" table="category">
        <unique-constraints>
            <unique-constraint name="idx_category_name" columns="name"/>
        </unique-constraints>

        <lifecycle-callbacks>
            <lifecycle-callback type="prePersist" method="initCreatedAt"/>
            <lifecycle-callback type="preUpdate" method="initUpdatedAt"/>
        </lifecycle-callbacks>

        <id name="name" type="string" column="name" length="255"/>

        <field name="priority" type="integer" nullable="true"/>
        <field name="createdAt" type="datetime_immutable"/>
        <field name="updatedAt" type="datetime_immutable"/>

        <many-to-many field="parents" target-entity="App\Entity\Category" inversed-by="children">
            <join-table name="category_parent">
                <join-columns>
                    <join-column name="category_name" referenced-column-name="name"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="parent_name" referenced-column-name="name"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <many-to-many field="children" target-entity="App\Entity\Category" mapped-by="parents"/>

        <one-to-many field="parameters" target-entity="App\Entity\Parameter" mapped-by="category"/>
    </entity>
</doctrine-mapping>